# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real .env - see .gitignore.
#   cp .env.example .env
#
# This file configures running the app ON THE HOST (npm run start:dev).
# The host in DATABASE_URL depends on where the app runs:
#
#   app on host    -> localhost
#   app in compose -> postgres  (the compose service name; only resolves
#                               on the compose network)
#
# When the app is added as a compose service it will set its own
# DATABASE_URL, so this value does not need editing.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Postgres ---
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/bulk_stage_move

# Hard cap on pooled connections. The bulk worker draws from this same pool as
# interactive traffic - sizing this is an isolation decision, not a default.
PG_POOL_MAX=20

# --- Bulk job behaviour ---
# Opportunities per batch.
BULK_BATCH_SIZE=1000
# Max opportunities a single submitted job may move.
BULK_MAX_OPPORTUNITIES=50000
# Days to retain bulk_job / bulk_job_item rows.
BULK_RETENTION_DAYS=60
# Max redelivery attempts for a failed batch before it is given up on.
BULK_DLQ_MAX_RETRIES=3

# --- Worker concurrency ---
# How many batches a worker may process at once, per workspace.
BULK_WORKER_CONCURRENCY=4
