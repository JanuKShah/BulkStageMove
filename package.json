{
  "name": "bulk-stage-move",
  "version": "0.1.0",
  "private": true,
  "description": "Bulk stage move for Opportunities - SDE-3 take-home",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:large": "tsx scripts/seed.ts --scale=large",
    "cli": "tsx scripts/cli.ts",
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down -v --remove-orphans",
    "dump": "tsx scripts/cli.ts dump-db",
    "verify": "npm run up && npm run seed && npm run dump && npm test",
    "test": "jest --runInBand",
    "test:safety": "jest --runInBand --selectProjects safety",
    "test:endpoints": "jest --runInBand --selectProjects endpoints",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
